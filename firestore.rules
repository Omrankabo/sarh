rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true; }
  match /users/{uid}/{kind}/{record} {
   function supported() { return kind in ['settings','progress','attempts','sessions','recallCards','recallEvents','recallMeta','imports','devices']; }
   allow read: if owner(uid) && supported();
   allow create, update: if owner(uid) && supported()
    && request.resource.data.keys().hasOnly(['key','value','at'])
    && request.resource.data.keys().hasAll(['key','value','at'])
    && request.resource.data.key is string && request.resource.data.at is number;
   allow delete: if owner(uid) && supported();
  }
  match /{document=**} { allow read, write: if false; }
 }
}
