{
  "name": "sarh-study",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/check-published.mjs && node scripts/check-release.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "content:check": "node scripts/check-published.mjs",
    "release:check": "node scripts/check-release.mjs",
    "firebase:test": "firebase emulators:exec --project demo-sarh --only auth,firestore \"node tests/firestore-rules.mjs && tsx tests/firebase-integration.ts\"",
    "postbuild": "node scripts/offline-assets.mjs && node scripts/check-traces.mjs"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "fake-indexeddb": "^6.2.6",
    "firebase-tools": "^14.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
