# Default for a fresh checkout: guest notebooks in IndexedDB.
NEXT_PUBLIC_FIREBASE_MODE=local
# Set mode to emulator for local Authentication + Firestore tests, or cloud for live accounts.
# Firebase web configuration is public client configuration; service-account secrets are never required here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
